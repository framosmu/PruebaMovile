<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://omnis.net"
    xmlns="http://omnis.net"
    elementFormDefault="qualified">

    <xs:element name="settings">
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
                <xs:element ref="group" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>


    <xs:element name="group">
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
                <xs:element ref="setting" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="group" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>

            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="displayName" type="xs:string"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="newPage" type="xs:boolean" default="false" />
            <xs:attribute name="exposed" type="xs:boolean" default="true" />
        </xs:complexType>
    </xs:element>


    <xs:element name="setting">
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
               <xs:element name="value" type="xs:string"/>
               <xs:element name="description" type="xs:string" minOccurs="0"/>
               <xs:element ref="options" minOccurs="0"/>
                <xs:element ref="other" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>

            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="displayName" type="xs:string"/>
            <xs:attribute name="exposed" type="xs:boolean" default="true" />
            <xs:attribute name="dataType" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="string" />
                        <xs:enumeration value="bool" />
                        <xs:enumeration value="int" />
                        <xs:enumeration value="float" />
                        <xs:enumeration value="button" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="options">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="option" maxOccurs="unbounded" >
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attribute name="displayName" type="xs:string"/>
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="other">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="name" type="xs:string"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>


</xs:schema>